            "raise_action": true,
            "photo_required": true
          },
          {
            "key": "bucket",
            "label": "Bucket, teeth, side cutters and quick hitch",
            "type": "ok_issue_na",
            "raise_action": true,
            "photo_required": true
          },
          {
            "key": "hitch_lock",
            "label": "Quick hitch safety lock and pin engagement",
            "type": "ok_issue_na",
            "raise_action": true,
            "photo_required": true
          },
          {
            "key": "slew",
            "label": "Slew ring bolts and house-to-undercarriage",
            "type": "ok_issue_na",
            "raise_action": true,
            "photo_required": true
          },
          {
            "key": "track_frames",
            "label": "Track frames, idler mounts and sprocket mounts",
            "type": "ok_issue_na",
            "raise_action": true,
            "photo_required": true
          },
          {
            "key": "counterweight",
            "label": "Counterweight mounting",
            "type": "ok_issue_na",
            "raise_action": true,
            "photo_required": true
          },
          {
